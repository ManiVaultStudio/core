@echo off
setlocal

set "MANIVAULT_INSTALL_DIR=@MV_INSTALL_DIR@"
set "QT_BIN_DIR=@QT_DIR@\..\..\..\bin"

for %%C in (Debug RelWithDebInfo Release MinSizeRel) do (
    if exist "%MANIVAULT_INSTALL_DIR%\%%C\MV_Public.dll" set "PATH=%MANIVAULT_INSTALL_DIR%\%%C;%PATH%"
)

set "PATH=%QT_BIN_DIR%;%PATH%"
"%~dp0PointDataBenchmark.exe" %*
exit /b %ERRORLEVEL%
